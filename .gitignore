*.pkl
*.joblib
models/*.pkl
models/*.joblib
!models/pipeline.joblib
mlruns/
mlflow.db
*.db
monitoring/*.db
data/*.db

# Testing & code coverage caches
.pytest_cache/
.coverage
htmlcov/

# Logs, environment variables & secrets
*.log
.env
.env.*
!.env.example

# IDE configurations
.vscode/
.idea/
